PORT=3000

# Publieke URL van de app; staat in de links in e-mails.
BASE_URL=http://localhost:3512

# Achter een reverse proxy (nginx, Traefik): aantal proxies, meestal 1.
# TRUST_PROXY=1

# Apenkaas (backend). Tenant en server-sleutel maak je in de Apenkaas-console;
# de collectie-id's staan in de uitvoer van scripts/push.mjs (zie README).
APENKAAS_URL=https://apenkaas.nl
APENKAAS_TENANT=
APENKAAS_KEY=
APENKAAS_LOTEN_COLLECTION_ID=
APENKAAS_DEELNEMERS_COLLECTION_ID=
APENKAAS_HERSTEL_COLLECTION_ID=
APENKAAS_HERSTEL_KLIKS_COLLECTION_ID=
# Bucket voor achtergrondfoto's per loting (niet verplicht; zonder bucket staat uploaden uit)
APENKAAS_ACHTERGRONDEN_BUCKET_ID=

# Inloggen voor organisatoren (gehoste loginpagina van Apenkaas).
# APENKAAS_APP_ID is het UUID van de app in de console; zet daar als redirect-URI
# <BASE_URL>/auth/callback. SESSION_SECRET: minimaal 32 willekeurige tekens, bijvoorbeeld
# `openssl rand -hex 32`.
APENKAAS_APP_ID=
SESSION_SECRET=

# Geheim voor de webhook "wachtwoord vergeten" (zelfde waarde in de Apenkaas-console), bijvoorbeeld
# `openssl rand -hex 32`. Zonder dit geeft de webhook 503 en komen er geen resetmails.
APENKAAS_WEBHOOK_SECRET=

# Gmail (niet verplicht, nodig voor inlogmails en lootje-herstel).
# Maak een app-wachtwoord op https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
